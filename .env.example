# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the agent and the deal hunter.
# A cheaper model lowers the per-run cost of the deal bot considerably.
# LUKA_MODEL=claude-opus-4-8


# ─────────────────────────────────────────────────────────────────────────────
# AFFILIATE PROGRAMS — this is what makes the app earn.
# Nothing here is required; with none of it set, links simply stay untagged.
# See MONETIZATION.md for how to get each of these IDs.
# ─────────────────────────────────────────────────────────────────────────────

# Amazon Associates. One tag for all marketplaces:
# AFF_AMAZON_TAG=yourname-20
# …or a separate tag per marketplace (Associates issues one per region):
# AFF_AMAZON_TAGS={"amazon.com":"yourname-20","amazon.ae":"yourname-21"}

# eBay Partner Network
# AFF_EBAY_CAMPID=5338xxxxxx
# AFF_EBAY_MKRID=711-53200-19255-0
# AFF_EBAY_SITEID=0
# AFF_EBAY_CUSTOMID=luka

# AliExpress affiliate (verify a real click reaches your dashboard —
# AliExpress tracks most reliably via links generated in their portal)
# AFF_ALIEXPRESS_PID=your_tracking_id

# Any other program, including the networks regional Gulf/MENA stores use
# (Admitad, Awin, CJ, Impact, ArabClicks). "params" appends tracking
# parameters; "deeplink" wraps the store URL in the network's redirect.
# AFF_RULES=[{"network":"admitad-noon","match":["noon.com"],"type":"deeplink","template":"https://ad.admitad.com/g/ABC123/?ulp={url}"}]


# ─────────────────────────────────────────────────────────────────────────────
# LINKS & TRACKING
# ─────────────────────────────────────────────────────────────────────────────

# Absolute base URL of your deployed app. REQUIRED for the Telegram bot —
# posts go out to the public, so the links in them must be absolute.
# LUKA_PUBLIC_URL=https://luka.example.com

# Signing secret for outbound links. Strongly recommended in production: with
# it set, /api/go follows only links this app generated. Any long random
# string — e.g. `openssl rand -base64 32`
# LUKA_LINK_SECRET=

# Extra hosts /api/go may redirect to, beyond the built-in store list.
# LUKA_ALLOWED_REDIRECT_HOSTS=mystore.jo,anotherstore.com

# Append every click to a file as newline-delimited JSON, so click history
# survives a restart. Leave unset to keep clicks in memory only.
# LUKA_CLICK_LOG=./clicks.jsonl

# Protects GET /api/stats (your click dashboard). Unset = endpoint disabled.
# LUKA_ADMIN_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# DEAL BOT — the scheduled hunter that posts to Telegram
# ─────────────────────────────────────────────────────────────────────────────

# Protects /api/deals. Unset = the endpoint refuses to run. Set this before
# scheduling anything: each run spends API credits and posts publicly.
# CRON_SECRET=

# From @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your channel (the bot must be an administrator there)
# TELEGRAM_CHAT_ID=@your_deals_channel


# ─────────────────────────────────────────────────────────────────────────────
# DESK — the AI receptionist for local businesses (see DESK.md)
# ─────────────────────────────────────────────────────────────────────────────

# ── STORAGE ──
# With these two set, everything persists in Postgres and the double-booking
# guard is a database constraint. Without them the app falls back to an
# in-memory store that loses every booking on restart — usable for local
# development only, and the UI says so on every screen.
# Run supabase/migrations/0001_receptionist_core.sql in the SQL editor first.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key — SERVER ONLY, never in the browser>

# Fallback businesses for local development, as a JSON array. Ignored once
# Supabase is configured. See DESK.md for the full shape.
# DESK_TENANTS=[{"id":"clinic-samer","name":"عيادة د. سامر",...}]

# Optional: a cheaper/faster model for the receptionist than the shopping agent.
# DESK_MODEL=claude-opus-4-8

# --- WhatsApp Cloud API (from a Meta Business account, opened in your name) ---
# The receptionist answers WhatsApp the moment these four exist.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_VERIFY_TOKEN=<any string you choose; paste the same one into Meta>
# WHATSAPP_APP_SECRET=<from Meta → App Settings → Basic>

# Which WhatsApp number belongs to which client:
# DESK_WHATSAPP_ROUTES={"1234567890":"clinic-samer"}
# DESK_DEFAULT_TENANT=clinic-samer

# Where escalations go — the owner's own WhatsApp number, digits only.
# DESK_OWNER_WHATSAPP=9627xxxxxxxx


# ─────────────────────────────────────────────────────────────────────────────
# VOICE — what the receptionist sounds like.
# With none of this set the browser's own voice speaks, which is audibly a
# robot. Any ONE of the three below replaces it with a neural voice.
# ─────────────────────────────────────────────────────────────────────────────

# Azure Speech — the only one with a real JORDANIAN accent, and the largest
# free grant (500k characters/month). Recommended for Jordan and the Gulf.
# Voices: ar-JO-TaimNeural (m), ar-JO-SanaNeural (f), ar-SA-HamedNeural,
#         ar-SA-ZariyahNeural, ar-AE-FatimaNeural, ar-EG-ShakirNeural …
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=uaenorth
# AZURE_SPEECH_VOICE=ar-JO-TaimNeural

# ElevenLabs — the most natural-sounding overall, but Modern Standard Arabic
# rather than any local dialect. Free tier is 10k characters/month.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI — easiest if a key is already on hand; its Arabic has a noticeable
# foreign accent, so prefer either of the two above for a paying client.
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# With several keys present, Azure is used first, then ElevenLabs, then OpenAI.
# Set this to force one (ignored if that provider has no key):
# TTS_PROVIDER=azure
