# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the agents
# LUKA_MODEL=claude-opus-4-8

# Optional: ElevenLabs voice for the interview simulator's interviewer.
# When set, the interviewer speaks with a realistic ElevenLabs voice
# (multilingual: the same voice speaks Arabic and English). When unset,
# the app falls back to the browser's built-in speech synthesis.
# ELEVENLABS_API_KEY=sk_...

# Optional: a specific ElevenLabs voice id. Clone a professional speaker in
# your field at https://elevenlabs.io/ and paste the voice id here to give
# the interviewer that voice. Defaults to the premade "Daniel" voice.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Optional: ElevenLabs model (default supports Arabic + English)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
