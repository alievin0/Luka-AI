# Server-side only — never exposed to the app bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-5)
# DASHLIGHT_MODEL=claude-opus-5

# Optional: how hard the model thinks about one scan — low | medium | high |
# xhigh | max. Default "high", which is what the route ran at before this was
# a setting. Every scan writes its token counts to the log, so lower this
# against measured results rather than on principle: a wrong verdict on a
# dashboard costs more than the tokens it saved.
# SCAN_EFFORT=high

# Server-side only — the accurate transcription pass for the lecture app.
# Without it the app still works: the on-device live writer produces the
# transcript, and "re-transcribe from the recording" reports that the accurate
# pass isn't enabled rather than failing silently.
# ELEVENLABS_API_KEY=sk_...
# SCRIBE_MODEL=scribe_v2

# Server-side only — the shared counter behind the rate limiter. Without both,
# the limit falls back to this instance's memory: it resets on every deploy and
# does not span instances, so N instances mean N times the allowance. The paid
# routes are public and unauthenticated, so set these before launch.
# Verify the wire format once against your instance before trusting it:
#   node scripts/check-ratelimit.js --probe "$UPSTASH_REDIS_REST_URL" "$UPSTASH_REDIS_REST_TOKEN"
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Client-side: absolute URL of the deployed API route.
# Leave unset in local dev — the app auto-detects the Expo dev server.
# EXPO_PUBLIC_API_URL=https://your-deployment.expo.app

# Client-side: where the privacy policies are served from. The default is
# inferred from the Vercel project name — confirm it resolves before you
# submit to a store, and set this if the production domain differs.
# EXPO_PUBLIC_SITE_URL=https://luka-ai.vercel.app

# Client-side: RevenueCat public SDK keys (safe to ship; leave unset to run
# the app in free mode without RevenueCat — required for Expo Go).
# EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
# EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx
