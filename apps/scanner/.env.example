# Server-side only — never exposed to the app bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the vision model (default: claude-opus-5)
# DASHLIGHT_MODEL=claude-opus-5

# Client-side: absolute URL of the deployed API route.
# Leave unset in local dev — the app auto-detects the Expo dev server.
# EXPO_PUBLIC_API_URL=https://your-deployment.expo.app

# Client-side: RevenueCat public SDK keys (safe to ship; leave unset to run
# the app in free mode without RevenueCat — required for Expo Go).
# EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
# EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx
